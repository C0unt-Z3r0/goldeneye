# Goldeneye - Variaveis de ambiente
# Copie para .env e preencha com suas chaves

# OpenAI API Key
OPENAI_API_KEY=sk-sua-chave-aqui

# Caminhos personalizados
GOLDENEYE_PROJECTS_DIR=~/goldeneye/projects
GOLDENEYE_TEMPLATES_DIR=~/goldeneye/templates
GOLDENEYE_CONFIG_DIR=~/goldeneye/config
GOLDENEYE_LOGS_DIR=~/goldeneye/logs
